# Copier ce fichier vers .env puis adapter les valeurs.
# Ne jamais versionner le fichier .env.

# --- Application ---
NODE_ENV=development
PORT=4000
# URL publique du client (retours de paiement)
CLIENT_URL=http://localhost:5173
# URL publique de l'API, joignable par l'agrégateur (webhook). En local : URL du tunnel.
API_URL=http://localhost:4000

# --- Base de données ---
DATABASE_URL="file:./dev.db"

# --- Authentification ---
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
JWT_DUREE=7d

# --- Paiement ---
# simulateur : aucun appel réseau, interdit en production
# paydunya   : utilise les clés ci-dessous
PAIEMENT_FOURNISSEUR=simulateur

# Clés PayDunya (tableau de bord PayDunya > Intégrer notre API)
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME=PayTonLoyer
# Facultatif : limite la page de paiement à un seul canal (ex. orange-money-senegal).
# Vide : PayDunya propose tous les moyens actifs. Consulter la liste officielle des canaux.
PAYDUNYA_CANAL_WAVE=
PAYDUNYA_CANAL_ORANGE_MONEY=
PAYDUNYA_CANAL_FREE_MONEY=

# --- SMS ---
# console : aucun SMS réel (affiché dans le terminal) ; orange : API SMS d'Orange Developer (offre Sénégal)
SMS_FOURNISSEUR=console
# Identifiants de l'application Orange (developer.orange.com > MyApps), après souscription à « SMS Senegal »
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=tel:+2210000
# Nom d'expéditeur affiché (11 caractères max) : à faire valider par Orange, sinon laisser vide
ORANGE_SMS_SENDER_NAME=

# --- SasPay (PAIEMENT_FOURNISSEUR=saspay) ---
# Clé API (app.saspay.me > Développeur). sk_test_… en développement : une clé sk_live_ y est refusée.
SASPAY_API_KEY=
# Secret de signature du webhook (Webhooks > Changer le secret ; affiché une seule fois)
SASPAY_WEBHOOK_SECRET=
# E-mail transmis à SasPay pour chaque paiement (obligatoire chez eux ; les locataires n'en ont pas)
SASPAY_EMAIL_CLIENT=
# Mettre « oui » seulement pour accepter de vrais paiements avec une clé sk_live_ hors production
SASPAY_AUTORISER_LIVE=
